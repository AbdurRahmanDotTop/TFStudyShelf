rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── Books (public read) ───────────────────────
    match /books/{bookId} {
      allow read: if true;
      allow write: if false; // Admin only via Cloud Functions
    }

    // ── Chapters (public read) ────────────────────
    match /books/{bookId}/chapters/{chapterId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Questions (public read) ───────────────────
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Flashcards (public read) ──────────────────
    match /flashcard_sets/{setId} {
      allow read: if true;
      allow write: if false;
    }

    match /flashcard_sets/{setId}/cards/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    // ── User Reading Progress ─────────────────────
    match /users/{uid}/progress/{bookId} {
      allow read, write: if isOwner(uid);
    }

    // ── User Saved Books ──────────────────────────
    match /users/{uid}/saved/{bookId} {
      allow read, write: if isOwner(uid);
    }

    // ── User Highlights ───────────────────────────
    match /users/{uid}/highlights/{highlightId} {
      allow read, write: if isOwner(uid);
    }

    // ── User Notes ───────────────────────────────
    match /users/{uid}/notes/{noteId} {
      allow read, write: if isOwner(uid);
    }

    // ── Categories (public read) ──────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
