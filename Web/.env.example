# TF Study Shelf — Web Environment Variables
# Copy this to .env and fill in your values
# ALL services use FREE TIER — no payment method required

# ═══════════════════════════════════════════════════
# Firebase Configuration (Free Spark Plan)
# ═══════════════════════════════════════════════════
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (for Workers — service account)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ═══════════════════════════════════════════════════
# Google Drive API (Free — 15GB storage)
# ═══════════════════════════════════════════════════
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id

# ═══════════════════════════════════════════════════
# YouTube Data API (Free — 10,000 quota units/day)
# ═══════════════════════════════════════════════════
YOUTUBE_API_KEY=your_youtube_api_key

# ═══════════════════════════════════════════════════
# Google AdSense (Web Ads — Free to set up)
# ═══════════════════════════════════════════════════
ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_BANNER_SLOT=xxxxxxxxxx
ADSENSE_INTERSTITIAL_SLOT=xxxxxxxxxx

# ═══════════════════════════════════════════════════
# App Configuration
# ═══════════════════════════════════════════════════
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
ADMIN_EMAIL=admin@example.com
