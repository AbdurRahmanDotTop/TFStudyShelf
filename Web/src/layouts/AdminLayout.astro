---
const { title = "TF Study Shelf — Admin Panel" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title}</title>
  <meta name="description" content="TF Study Shelf Administration Panel — Content Management System">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23FF7759'/%3E%3Ctext x='50%25' y='55%25' text-anchor='middle' dominant-baseline='middle' font-family='sans-serif' font-weight='700' font-size='14' fill='white'%3ETF%3C/text%3E%3C/svg%3E">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/design-tokens.css">
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin/admin-layout.css">

  <!-- Material Icons -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap">
</head>
<body>

  <!-- ═══ Login Screen ═══════════════════════════════════════ -->
  <div id="admin-login" class="hidden">
    <div class="login-wrapper">
      <div class="login-card">
        <div class="login-card__header">
          <div class="admin-sidebar__logo-mark" style="width:48px;height:48px;font-size:18px;margin:0 auto var(--space-md)">TF</div>
          <h1 style="font-size:22px;text-align:center;margin-bottom:4px">Admin Panel</h1>
          <p style="text-align:center;color:var(--text-secondary);font-size:14px">TF Study Shelf</p>
        </div>
        <form id="admin-login-form" style="margin-top:var(--space-xl)">
          <div class="form-group" style="margin-bottom:var(--space-md)">
            <label class="form-label" for="login-email">Email</label>
            <input type="email" id="login-email" class="form-input" placeholder="admin@example.com" required autocomplete="email">
          </div>
          <div class="form-group" style="margin-bottom:var(--space-lg)">
            <label class="form-label" for="login-password">Password</label>
            <input type="password" id="login-password" class="form-input" placeholder="••••••••" required autocomplete="current-password" minlength="8">
          </div>
          <div id="login-error" class="form-error hidden" style="margin-bottom:var(--space-md)"></div>
          <button type="submit" class="btn btn-primary btn-full" id="login-submit">
            <span class="spinner spinner-sm hidden" id="login-spinner"></span>
            Sign In
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ═══ Admin Shell ════════════════════════════════════════ -->
  <div id="admin-app" class="admin-shell hidden">

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-sidebar__header">
        <div class="admin-sidebar__logo">
          <div class="admin-sidebar__logo-mark">TF</div>
          <div>
            <div class="admin-sidebar__logo-text">TF Study Shelf</div>
            <span class="admin-sidebar__logo-badge">Admin Panel</span>
          </div>
        </div>
      </div>

      <nav class="admin-sidebar__nav">
        <div class="admin-sidebar__section-label">Overview</div>
        <a href="/admin" class="admin-sidebar__link" data-page="dashboard">
          <span class="material-symbols-outlined icon">dashboard</span> Dashboard
        </a>

        <div class="admin-sidebar__section-label">Content</div>
        <a href="/admin/books" class="admin-sidebar__link" data-page="books">
          <span class="material-symbols-outlined icon">menu_book</span> Books
        </a>
        <a href="/admin/chapters" class="admin-sidebar__link" data-page="chapters">
          <span class="material-symbols-outlined icon">format_list_numbered</span> Chapters
        </a>
        <a href="/admin/questions" class="admin-sidebar__link" data-page="questions">
          <span class="material-symbols-outlined icon">help_outline</span> Questions
        </a>
        <a href="/admin/quizzes" class="admin-sidebar__link" data-page="quizzes">
          <span class="material-symbols-outlined icon">quiz</span> Quizzes
        </a>
        <a href="/admin/flashcards" class="admin-sidebar__link" data-page="flashcards">
          <span class="material-symbols-outlined icon">style</span> Flashcards
        </a>
        <a href="/admin/categories" class="admin-sidebar__link" data-page="categories">
          <span class="material-symbols-outlined icon">category</span> Categories
        </a>

        <div class="admin-sidebar__section-label">Management</div>
        <a href="/admin/users" class="admin-sidebar__link" data-page="users" data-role="SUPER_ADMIN">
          <span class="material-symbols-outlined icon">people</span> Users
        </a>
        <a href="/admin/ads" class="admin-sidebar__link" data-page="ads" data-role="SUPER_ADMIN">
          <span class="material-symbols-outlined icon">ad_units</span> Ads
        </a>
        <a href="/admin/notifications" class="admin-sidebar__link" data-page="notifications">
          <span class="material-symbols-outlined icon">notifications</span> Notifications
        </a>

        <div class="admin-sidebar__section-label">System</div>
        <a href="/admin/settings" class="admin-sidebar__link" data-page="settings" data-role="SUPER_ADMIN">
          <span class="material-symbols-outlined icon">settings</span> Settings
        </a>
        <a href="/admin/audit" class="admin-sidebar__link" data-page="audit" data-role="SUPER_ADMIN">
          <span class="material-symbols-outlined icon">history</span> Audit Log
        </a>
      </nav>

      <div class="admin-sidebar__footer">
        <div class="admin-sidebar__user">
          <div class="avatar" id="admin-avatar">A</div>
          <div class="admin-sidebar__user-info">
            <div class="admin-sidebar__user-name" id="admin-name">Admin</div>
            <div class="admin-sidebar__user-role" id="admin-role">Super Admin</div>
          </div>
          <button class="btn-icon" id="admin-logout" title="Sign Out">
            <span class="material-symbols-outlined" style="font-size:20px;color:rgba(250,250,250,0.5)">logout</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar__left">
          <button class="admin-topbar__menu-btn btn-icon" id="sidebar-toggle">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <div class="admin-topbar__breadcrumb" id="admin-breadcrumb">
            <a href="/admin">Admin</a>
            <span>›</span>
            <span class="current" id="breadcrumb-current">Dashboard</span>
          </div>
        </div>
        <div class="admin-topbar__right">
          <button class="btn-icon" id="theme-toggle" title="Toggle theme">
            <span class="material-symbols-outlined">dark_mode</span>
          </button>
        </div>
      </header>

      <div class="admin-content" id="admin-page-content">
        <slot />
      </div>
    </main>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toast-container"></div>

  <!-- Modal Container -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal" id="modal-content"></div>
  </div>

  <style>
    .login-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-lg);
      background: var(--bg-primary);
    }
    .login-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: var(--space-2xl);
      width: 100%;
      max-width: 400px;
      box-shadow: var(--shadow-2);
    }
  </style>

  <!-- Firebase SDKs -->
  <script is:inline src="https://www.gstatic.com/firebasejs/10.8.1/firebase-app-compat.js"></script>
  <script is:inline src="https://www.gstatic.com/firebasejs/10.8.1/firebase-auth-compat.js"></script>
  <script is:inline src="https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore-compat.js"></script>
  
  <script is:inline>
    const firebaseConfig = {
      apiKey: "AIzaSyBPrR9vg5_b_jqwWDPGD0mXC5NsWWfk6hU",
      authDomain: "tf-study-shelf.firebaseapp.com",
      projectId: "tf-study-shelf",
      storageBucket: "tf-study-shelf.firebasestorage.app",
      messagingSenderId: "56578777667",
      appId: "1:56578777667:web:12172da5fd1bb6c43b2af6",
      measurementId: "G-CV7CTPNVMC"
    };
    
    if (typeof firebase !== 'undefined' && !firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
      window.db = firebase.firestore();
    }
  </script>

  <!-- Scripts -->
  <script src="/js/utils/storage.js" is:inline></script>
  <script src="/js/utils/theme.js" is:inline></script>
  <script src="/js/api/client.js" is:inline></script>
  <script src="/js/components/toast.js" is:inline></script>
  <script src="/js/components/modal.js" is:inline></script>
  
  <!-- Setup Authentication and Active States -->
  <script is:inline>
    // Minimal Auth handling
    let currentUser = null;
    function showLogin() {
      document.getElementById('admin-login').classList.remove('hidden');
      document.getElementById('admin-app').classList.add('hidden');
    }

    function showApp() {
      document.getElementById('admin-login').classList.add('hidden');
      document.getElementById('admin-app').classList.remove('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (window.ThemeManager) window.ThemeManager.init();
      
      // Update sidebar active state
      const path = window.location.pathname;
      document.querySelectorAll('.admin-sidebar__link').forEach(link => {
        if(link.getAttribute('href') === path || (path === '/admin/' && link.getAttribute('href') === '/admin')) {
          link.classList.add('active');
          const title = link.textContent.trim();
          const breadcrumb = document.getElementById('breadcrumb-current');
          if(breadcrumb) breadcrumb.textContent = title;
        } else {
          link.classList.remove('active');
        }
      });

      // Mobile sidebar
      document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
        document.getElementById('admin-sidebar').classList.toggle('open');
      });

      // Auth Logic
      if (typeof firebase !== 'undefined' && firebase.auth) {
        firebase.auth().onAuthStateChanged((user) => {
          if (user) {
            currentUser = { uid: user.uid, email: user.email, adminRole: 'Admin' };
            document.getElementById('admin-name').textContent = (user.email || 'Admin').split('@')[0];
            document.getElementById('admin-role').textContent = currentUser.adminRole;
            document.getElementById('admin-avatar').textContent = (user.email || 'A')[0].toUpperCase();
            user.getIdToken().then(token => ApiClient.setAuthToken(token));
            showApp();
          } else {
            handleLogout();
          }
        });
      } else {
        const storedToken = Storage.get('admin_token');
        if (storedToken) {
          ApiClient.setAuthToken(storedToken);
          showApp();
        } else {
          showLogin();
        }
      }

      document.getElementById('admin-login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-email').value.trim();
        const password = document.getElementById('login-password').value;
        const errorEl = document.getElementById('login-error');
        const spinner = document.getElementById('login-spinner');
        
        errorEl.classList.add('hidden');
        spinner.classList.remove('hidden');

        try {
          if (typeof firebase !== 'undefined' && firebase.auth) {
            const credential = await firebase.auth().signInWithEmailAndPassword(email, password);
            const token = await credential.user.getIdToken();
            ApiClient.setAuthToken(token);
          } else {
            const mockToken = btoa(JSON.stringify({ sub: 'dev-admin', email, role: 'SUPER_ADMIN', exp: Math.floor(Date.now() / 1000) + 3600 }));
            ApiClient.setAuthToken(mockToken);
            Storage.set('admin_token', mockToken);
          }
          window.location.reload();
        } catch (err) {
          errorEl.textContent = err.message || 'Invalid credentials';
          errorEl.classList.remove('hidden');
          spinner.classList.add('hidden');
        }
      });

      document.getElementById('admin-logout')?.addEventListener('click', handleLogout);
    });

    function handleLogout() {
      if (typeof firebase !== 'undefined' && firebase.auth) {
        firebase.auth().signOut();
      }
      ApiClient.setAuthToken(null);
      Storage.remove('admin_token');
      showLogin();
    }

    // Polyfill AdminApp for MPA Routing
    window.AdminApp = {
      navigate: function(page, params = {}) {
        let url = '/admin/' + (page === 'dashboard' ? '' : page);
        // Special case for books editor
        if (page === 'books' && (params.action === 'new' || params.action === 'edit')) {
          url = '/admin/book-editor';
        }
        
        const searchParams = new URLSearchParams(params);
        const qs = searchParams.toString();
        if (qs) {
          url += '?' + qs;
        }
        window.location.href = url;
      }
    };
  </script>
</body>
</html>
