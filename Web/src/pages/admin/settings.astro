---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Settings — Admin Panel">
  <div id="admin-page-content-inner">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-header__title">Settings</h1>
        <p class="admin-page-header__subtitle">System configuration and feature flags</p>
      </div>
    </div>
    <div class="card" style="text-align:center;padding:var(--space-3xl)">
      <div class="empty-state__icon" style="margin:0 auto var(--space-md)">
        <span class="material-symbols-outlined" style="font-size:28px">settings</span>
      </div>
      <h3 class="text-title-large mb-sm">Coming Next</h3>
      <p class="text-body-medium text-secondary">System configuration and feature flags. This page will be implemented in the next phase.</p>
    </div>
  </div>
</AdminLayout>
