---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Course Editor — Admin Panel">
  <div id="admin-page-content-inner"></div>
  
  <script is:inline src="/js/pages/admin/course-editor.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const checkAuth = setInterval(() => {
        if (typeof ApiClient !== 'undefined' && ApiClient.getAuthToken()) {
          clearInterval(checkAuth);
          if (window.AdminCourseEditor) {
            const urlParams = new URLSearchParams(window.location.search);
            const params = {
              action: urlParams.get('action') || 'new',
              id: urlParams.get('id')
            };
            AdminCourseEditor.render(document.getElementById('admin-page-content-inner'), params);
          }
        }
      }, 100);
      setTimeout(() => clearInterval(checkAuth), 5000);
    });
  </script>
</AdminLayout>
