---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Dashboard — Admin Panel">
  <div id="admin-page-content-inner"></div>
  
  <script is:inline src="/js/pages/admin/dashboard.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Check auth before rendering
      const checkAuth = setInterval(() => {
        if (typeof ApiClient !== 'undefined' && ApiClient.getAuthToken()) {
          clearInterval(checkAuth);
          if (window.AdminDashboard) {
            AdminDashboard.render(document.getElementById('admin-page-content-inner'));
          }
        }
      }, 100);
      
      // Stop checking after 5 seconds if not logged in
      setTimeout(() => clearInterval(checkAuth), 5000);
    });
  </script>
</AdminLayout>
